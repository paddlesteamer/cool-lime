{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "noEmit": true, "paths": { "@shared/*": ["./src/shared/*"] },
    "types": ["node"], "noUncheckedSideEffectImports": false
  },
  "include": ["src", "electron.vite.config.ts"]
}
